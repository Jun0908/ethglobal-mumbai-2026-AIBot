# Copy to .env. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto: OpenAI if key exists, otherwise clearly labelled scripted demo
LLM_MODE=auto
# Fictional matches only. false requires the matching service below.
DEMO_MODE=true
# Required for non-demo use: 32 random bytes as 64 hex characters
PERSONA_ENCRYPTION_KEY=
PERSONA_DATA_DIR=.data/personas
# Vercel requires both credentials from a connected free Upstash Redis database.
# Keep these server-side; local development can continue with file storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MATCHING_API_URL=
MATCHING_API_TOKEN=
# Shared key for verifying short-lived HMAC identity assertions from PSI backend
MATCHING_IDENTITY_SECRET=
# Optional exact HTTPS origin when sharing behind a reverse proxy (no trailing path)
MASALA_PUBLIC_ORIGIN=
